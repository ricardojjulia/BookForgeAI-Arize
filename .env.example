NEXT_PUBLIC_SITE_URL=http://localhost:4747

# Leave unset (or "self_hosted") if you're running this repo yourself --
# CreativeWriter's full writing desk works the same either way. Set to
# "managed_saas" only for a managed hosted deployment: that additionally
# turns on CreativeWriter's collaboration panels (reader comment triage,
# contributor suggestion/assignment review) as a companion capability.
# There's no per-user entitlement system yet, so this is deployment-wide.
# See src/lib/creativewriter-ui/access.ts.
NEXT_PUBLIC_DEPLOYMENT_MODE=self_hosted

# Resend (https://resend.com) — leave blank to skip email, invite URL still shown in UI
RESEND_API_KEY=
# Optional: defaults to BookForge <onboarding@resend.dev> (works without domain verification)
RESEND_FROM=

# Supabase local values come from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only -- never exposed to the browser, never committed. Powers
# account deletion, the Steward console, and other admin-only operations.
# From `supabase status` -> "service_role key".
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token required by /api/internal/* cron-triggered routes (account purge
# flagging, collaboration email retries, CreativeWriter assignment reminders).
# Vercel Cron sends this automatically when the same value is set as a Vercel
# project env var -- see vercel.json for the schedule.
CRON_SECRET=

# LM Studio defaults.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Optional: override the Rewrite Architect planner's model-call timeout (ms).
# Defaults to 300000 (5 min) -- raise this for a large/slow local model on a
# big manuscript. See src/app/api/books/[bookId]/rewrite-plan/route.ts.
BOOKFORGE_REWRITE_PLAN_TIMEOUT_MS=

# Optional: override the Manuscript Blueprint analyzer's per-chunk model-call
# timeout (ms). Defaults to 240000 (4 min) -- raise this for a large/slow
# local model. See src/app/api/books/[bookId]/analyze/route.ts.
BOOKFORGE_ANALYZE_CHUNK_TIMEOUT_MS=

# Optional: override the chapter summarizer's per-chapter model-call timeout
# (ms). Defaults to 240000 (4 min) -- raise this for a large/slow local
# model. See src/app/api/books/[bookId]/chapters/summarize/route.ts.
BOOKFORGE_CHAPTER_SUMMARY_TIMEOUT_MS=

# Optional: override BookForge Critic's per-lens model-call timeout (ms).
# Defaults to 140000 (cloud) or 300000 (local, since critic/all's local
# concurrency cap still means some queuing). See src/lib/critic/run.ts.
BOOKFORGE_CRITIC_TIMEOUT_MS=

# Cloud LLM providers — only needed if a user selects one under Settings > Cloud
# provider, or LLM_PROVIDER below is set. See src/lib/ai/providers.ts.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# OpenRouter — one key, many backends (https://openrouter.ai/keys). See
# docs/openrouter-integration-plan.md for the recommended default models.
OPENROUTER_API_KEY=
# Optional: sent as the HTTP-Referer header on OpenRouter requests (shows up
# in OpenRouter's usage dashboard/rankings). Defaults to https://bookforge.app.
OPENROUTER_APP_URL=

# Required for the "bookforge_managed" subscription tier family (managed-SaaS
# only): a Management/Provisioning key on a DEDICATED OpenRouter account that
# BookForge itself owns and funds -- not the same account/key as
# OPENROUTER_API_KEY above. Used to mint per-user scoped, spend-capped keys
# with no key of any kind requested from the user. See
# src/lib/openrouter/management.ts / resolveOpenRouterManagementKey.
OPENROUTER_MASTER_MANAGEMENT_KEY=

# Optional: force a specific cloud provider/model without a per-user DB row
# (see getStandardLlmSettingsFromEnv in src/lib/ai/providers.ts). Leave unset
# to use LM Studio / per-user settings instead.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=
LLM_MAX_OUTPUT_TOKENS=

# Optional per-request model-call timeout for Rewrite Architect planning.
# Increase for slower local models or large planning prompts. Defaults to 300000.
BOOKFORGE_REWRITE_PLAN_TIMEOUT_MS=
# Optional per-chunk model-call timeout for Manuscript Blueprint analysis.
# Increase for slower local models or large analysis chunks. Defaults to 300000.
BOOKFORGE_ANALYZE_CHUNK_TIMEOUT_MS=
# Optional per-lens BookForge Critic timeout. Defaults to 140000 for cloud and
# 300000 for local LM Studio.
BOOKFORGE_CRITIC_TIMEOUT_MS=

# BookForge AI observability — server-side only. Observability is optional and
# must fail open: BookForge must continue to work if the collector is absent.
BOOKFORGE_OTEL_ENABLED=false
BOOKFORGE_OTEL_SERVICE_NAME=bookforge-ai-arize
BOOKFORGE_OTEL_PROJECT_NAME=bookforge-ai-arize
# Local Phoenix OTLP/HTTP trace endpoint.
BOOKFORGE_OTEL_ENDPOINT=http://localhost:6006/v1/traces
# Optional OTLP authentication headers. Leave blank for local Phoenix.
BOOKFORGE_OTEL_SPACE_ID=
BOOKFORGE_OTEL_API_KEY=
# Privacy defaults. Raw manuscript/prompt/completion content stays off unless
# deliberately enabled in a controlled environment.
BOOKFORGE_TRACE_CONTENT=false
BOOKFORGE_TRACE_USER_IDENTIFIERS=false
# Optional initialization diagnostics in the server console.
BOOKFORGE_OTEL_DEBUG=false

# Managed-SaaS billing only (Stripe) -- not used in self-hosted mode, and the
# billing code path never runs unless NEXT_PUBLIC_DEPLOYMENT_MODE=managed_saas
# is also set. See docs/SELF_HOSTING.md if you're running this repo yourself;
# leave these blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: hCaptcha on the sign-in/sign-up form (https://hcaptcha.com), site
# key only -- the matching secret key lives in Supabase's own Auth settings
# (Authentication > Attack Protection), not here. Leave blank to render the
# form with no CAPTCHA widget, which is correct for self-hosted/local use;
# only set this alongside enabling CAPTCHA in your Supabase project's Auth
# settings, and only after confirming this env var is live in every
# environment that talks to that project -- Supabase enforces the CAPTCHA
# token project-wide once enabled, so a sign-in/sign-up from anywhere still
# missing this key would be rejected.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
